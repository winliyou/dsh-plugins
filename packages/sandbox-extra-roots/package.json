{
  "name": "@dsh-plugins/sandbox-extra-roots",
  "version": "0.1.0",
  "description": "DSH host plugin: extra writable roots for the workspace-write sandbox (Seatbelt/bwrap/Landlock profiles and the fs fence)",
  "type": "module",
  "license": "MIT",
  "files": [
    "lib",
    "client",
    "install.sh",
    "uninstall.sh",
    "README.md"
  ],
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./client/client.cjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale",
        "remote",
        "remote.sandboxExtraRootsConfig"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-sandbox": "^0.1.0-rc.6",
    "@deepseek-ai/node-addon-landlock-run": "^0.1.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node ../../scripts/test.mjs",
    "prepublishOnly": "npm test"
  }
}
