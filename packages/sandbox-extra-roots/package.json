{
  "name": "@chaoset/sandbox-extra-roots",
  "version": "0.2.4",
  "description": "DSH host plugin: extra writable roots for the workspace-write sandbox (Seatbelt/bwrap/Landlock profiles and the fs fence)",
  "type": "module",
  "license": "MIT",
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./client/client.cjs",
    "./typert": "./lib/typert.host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale",
        "remote"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-sandbox": "^0.1.0-rc.6"
  },
  "optionalDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@deepseek-ai/node-addon-landlock-run": "^0.1.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node ../../scripts/test.mjs",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/winliyou/dsh-plugins.git",
    "directory": "packages/sandbox-extra-roots"
  },
  "publishConfig": {
    "access": "public"
  }
}
