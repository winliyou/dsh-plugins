{
  "name": "@dsh-plugins/vision-router",
  "version": "0.1.0",
  "description": "DSH host plugin: route image requests to a vision model for transcription when the session model is text-only",
  "type": "module",
  "license": "MIT",
  "files": [
    "lib",
    "client",
    "install.sh",
    "uninstall.sh",
    "README.md"
  ],
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./client/client.cjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale",
        "remote",
        "remote.visionRouterConfig"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6"
  },
  "optionalDependencies": {
    "sharp": "^0.33.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node ../../scripts/test.mjs",
    "prepublishOnly": "npm test"
  }
}
