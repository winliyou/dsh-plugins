{
  "name": "@chaoset/vision-router",
  "version": "0.5.0",
  "description": "DSH host plugin: route image requests to a vision model for transcription when the session model is text-only",
  "type": "module",
  "license": "MIT",
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./client/client.cjs",
    "./typert": "./lib/typert.host.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots",
        "locale",
        "remote"
      ]
    }
  },
  "optionalDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.7"
  },
  "scripts": {
    "test": "bun ../../scripts/test.mjs",
    "prepublishOnly": "bun ../../scripts/test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/winliyou/dsh-plugins.git",
    "directory": "packages/vision-router"
  },
  "publishConfig": {
    "access": "public"
  }
}
