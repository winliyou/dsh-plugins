{
  "name": "dsh-plugins",
  "private": true,
  "description": "DSH host 层插件集：vision-router（识图降级）/ sandbox-extra-roots（沙盒额外目录）/ adaptive-perf（极简性能自适应）/ session-archive（归档会话管理）",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winliyou/dsh-plugins.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "cordis",
    "session-archive",
    "archive"
  ],
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "bun scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:ci": "bun run build && vitest run"
  }
}
