# dsh-any-connect 锁 dsh 0.1.1-rc.2 稳定线，而本仓其余包在 0.1.2-alpha.x 线。
# pnpm 默认 auto-install-peers 会把两线的 dsh peer 拉进同一解析，触发
# `No matching version for @deepseek-ai/dsh-code-runtime@>=0.1.2` 之类的
# prerelease 范围冲突。关闭后 peer 由各包 optionalDependencies 显式满足，
# lockfile 里已固化完整解析（见 packages/dsh-any-connect 的 importer）。
auto-install-peers=false
