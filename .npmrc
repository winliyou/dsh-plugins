# 关闭 auto-install-peers：默认开启时 pnpm 会把各包的 dsh peer 拉进同一次
# 解析，不同包锁定的宿主 prerelease range 会互相冲突（如 `No matching
# version for @deepseek-ai/dsh-code-runtime@>=0.1.2`）。关闭后 peer 由各包
# optionalDependencies 显式满足，lockfile 固化完整解析。各包当前锁定哪条
# dsh 宿主线以各自 package.json 为准，分支模型见 RELEASING.md。
auto-install-peers=false
